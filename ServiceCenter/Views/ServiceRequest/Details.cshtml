@using ServiceCenter.Models
@model ServiceRequest
@{
    ViewData["Title"] = Model.Title;

    var statusClass = Model.Status switch
    {
        ServiceRequestStatus.Unresolved => "bg-danger",
        ServiceRequestStatus.InProgress => "bg-warning text-dark",
        _ => "bg-success"
    };
    var nextStepLabel = Model.Status == ServiceRequestStatus.Unresolved
        ? "Start work"
        : "Close request";
}

<a asp-action="Index" class="btn btn-link px-0 mb-3">&larr; Back to list</a>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="badge @statusClass">@Model.Status</span>
        <span class="badge bg-secondary">@Model.Priority priority</span>
    </div>
    <div class="card-body">
        <h1 class="h4 card-title">@Model.Title</h1>
        <h6 class="card-subtitle mb-3 text-body-secondary">
            @Model.RequesterName · @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
        </h6>
        <p class="card-text" style="white-space: pre-line">@Model.Description</p>
    </div>
    <div class="card-footer">
        @if (Model.Status != ServiceRequestStatus.Closed)
        {
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-primary">@nextStepLabel</button>
            </form>
        }
        else
        {
            <span class="text-body-secondary">This request is closed.</span>
        }
    </div>
</div>
